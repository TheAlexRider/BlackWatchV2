{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BWReadS3AccessLogsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::longhealth-security-s3-access-logs",
        "arn:aws:s3:::longhealth-security-s3-access-logs/*"
      ]
    }
  ]
}
