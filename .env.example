# Postgres connection string used by the BlackWatch app.
DATABASE_URL=postgresql://blackwatch:blackwatch@localhost:5432/blackwatch

# Comma-separated token:module pairs. The token a source presents in the
# X-BlackWatch-Token header determines which module its events are stamped with.
# Unmapped modules fall back to the generic passthrough adapter.
BLACKWATCH_TOKENS=devtoken:generic,vpntoken:vpn.openvpn

# Optional default account/tenant stamped on events when a source omits it.
# BLACKWATCH_ACCOUNT=
