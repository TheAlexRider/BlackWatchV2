{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BlackWatchReadCloudTrailQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
